rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow anyone to read global mood counts (no auth required)
    match /globalMoods/{moodId} {
      allow read: if true;
      allow write: if true; // In production, consider restricting writes
    }

    // Allow anyone to read active users for the globe
    match /activeUsers/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // User mood history — only the owner can read/write their own data
    match /userMoods/{userId}/history/{entryId} {
      allow read, write: if true; // For simplicity; tighten in production
    }
  }
}
